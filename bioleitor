import React, { useMemo, useState } from 'react';
import {
  BookOpen,
  CalendarDays,
  Target,
  Plus,
  Brain,
  ClipboardCheck,
  GraduationCap,
  Timer,
  Trash2,
  CheckCircle2
} from 'lucide-react';

const QUIZ_BASE = [
  'Como você classificaria seu domínio dos conceitos fundamentais?',
  'Você consegue explicar os processos fisiopatológicos sem consulta?',
  'Qual seu nível de segurança na interpretação de exames?',
  'Você domina os principais biomarcadores do tema?',
  'Consegue relacionar teoria e prática clínica/laboratorial?',
  'Qual seu nível em resolução de questões de provas anteriores?',
  'Você consegue resumir o assunto para outra pessoa?',
  'Qual seu domínio de protocolos e diretrizes atualizadas?',
  'Consegue identificar seus erros mais frequentes no tema?',
  'Quão consistente está sua rotina de revisão desse conteúdo?'
];

const LEVEL_LABELS = {
  1: 'Iniciante',
  2: 'Básico',
  3: 'Intermediário',
  4: 'Avançado',
  5: 'Especialista'
};

const makeSubject = (name) => ({
  id: Date.now() + Math.random(),
  name,
  quiz: QUIZ_BASE.map((q) => ({ question: q, answer: 3 })),
  quizDone: false,
  handbook: null,
  generatedTests: []
});

const makeExam = (subject, weakTopics) => ({
  id: Date.now() + Math.random(),
  title: `Avaliação - ${subject}`,
  questions: Array.from({ length: 10 }).map((_, i) => {
    const topic = weakTopics[i % weakTopics.length] || 'conceitos essenciais';
    return `${i + 1}. Questão aplicada sobre ${topic} com foco em raciocínio clínico-laboratorial.`;
  })
});

const inferWeakTopics = (quiz) => {
  const map = [
    'fundamentos teóricos',
    'fisiopatologia',
    'interpretação de exames',
    'biomarcadores',
    'aplicação clínica',
    'resolução de questões',
    'síntese e revisão ativa',
    'protocolos atualizados',
    'análise de erros',
    'disciplina de revisão'
  ];

  return quiz
    .map((q, i) => ({
      topic: map[i],
      score: q.answer
    }))
    .filter((x) => x.score <= 3)
    .sort((a, b) => a.score - b.score)
    .map((x) => x.topic);
};

const buildHandbookByLevel = ({ subject, average, weakTopics }) => {
  const level = LEVEL_LABELS[Math.round(average)] || 'Intermediário';
  const intensidade = average <= 2 ? 'alta' : average <= 3 ? 'moderada' : 'direcionada';

  return {
    level,
    diagnosis: `Seu nível atual em ${subject} é ${level}. A estratégia recomendada é de intensidade ${intensidade}, priorizando lacunas críticas primeiro.`,
    whatToImprove: weakTopics.length
      ? weakTopics
      : ['aprofundamento em resolução de casos e revisão ativa'],
    studyPlan: [
      `Semana 1-2: revisão estruturada de base (${subject}) + mapas mentais.`,
      'Semana 3: questões comentadas por tema e flashcards de pontos críticos.',
      'Semana 4: simulado com correção guiada por erros e reforço adaptativo.',
      'Revisão contínua: ciclos de 24h, 7 dias e 30 dias.'
    ],
    practicalTips: [
      'Use bloco diário de 50 min + 10 min pausa.',
      'Registre erros em um caderno de falhas para revisões semanais.',
      'Faça pelo menos 2 simulados por mês na matéria.'
    ]
  };
};

const App = () => {
  const [subjects, setSubjects] = useState([
    makeSubject('Hematologia'),
    makeSubject('Microbiologia Clínica')
  ]);
  const [activeSubjectId, setActiveSubjectId] = useState(subjects[0].id);
  const [newSubjectName, setNewSubjectName] = useState('');

  const [agendaItems, setAgendaItems] = useState([]);
  const [goalItems, setGoalItems] = useState([]);
  const [commitments, setCommitments] = useState([]);

  const [agendaForm, setAgendaForm] = useState({ title: '', date: '' });
  const [goalForm, setGoalForm] = useState({ title: '', deadline: '' });
  const [commitmentForm, setCommitmentForm] = useState({ title: '', date: '' });

  const activeSubject = useMemo(
    () => subjects.find((s) => s.id === activeSubjectId) || subjects[0],
    [subjects, activeSubjectId]
  );

  const updateActiveSubject = (updater) => {
    setSubjects((prev) =>
      prev.map((s) => (s.id === activeSubject.id ? updater(s) : s))
    );
  };

  const addSubject = () => {
    if (!newSubjectName.trim()) return;
    const created = makeSubject(newSubjectName.trim());
    setSubjects((prev) => [...prev, created]);
    setActiveSubjectId(created.id);
    setNewSubjectName('');
  };

  const removeSubject = (id) => {
    if (subjects.length === 1) return;
    const next = subjects.filter((s) => s.id !== id);
    setSubjects(next);
    if (activeSubjectId === id) setActiveSubjectId(next[0].id);
  };

  const finishQuizAndGenerate = () => {
    const average =
      activeSubject.quiz.reduce((acc, q) => acc + q.answer, 0) /
      activeSubject.quiz.length;
    const weakTopics = inferWeakTopics(activeSubject.quiz);
    const handbook = buildHandbookByLevel({
      subject: activeSubject.name,
      average,
      weakTopics
    });

    updateActiveSubject((s) => ({ ...s, quizDone: true, handbook }));
  };

  const generateNewEvaluation = () => {
    const weakTopics = activeSubject.handbook?.whatToImprove || ['conceitos gerais'];
    const exam = makeExam(activeSubject.name, weakTopics);
    updateActiveSubject((s) => ({
      ...s,
      generatedTests: [exam, ...s.generatedTests]
    }));
  };

  const addItem = (type) => {
    if (type === 'agenda' && agendaForm.title && agendaForm.date) {
      setAgendaItems((prev) => [...prev, { ...agendaForm, id: Date.now() + Math.random() }]);
      setAgendaForm({ title: '', date: '' });
    }
    if (type === 'goal' && goalForm.title && goalForm.deadline) {
      setGoalItems((prev) => [...prev, { ...goalForm, id: Date.now() + Math.random(), done: false }]);
      setGoalForm({ title: '', deadline: '' });
    }
    if (type === 'commitment' && commitmentForm.title && commitmentForm.date) {
      setCommitments((prev) => [...prev, { ...commitmentForm, id: Date.now() + Math.random() }]);
      setCommitmentForm({ title: '', date: '' });
    }
  };

  const toggleGoal = (id) => {
    setGoalItems((prev) => prev.map((g) => (g.id === id ? { ...g, done: !g.done } : g)));
  };

  const examHelp = useMemo(() => {
    if (!activeSubject?.handbook) {
      return [
        'Conclua a avaliação inicial da matéria para receber um plano de provas personalizado.',
        'Após isso, gere avaliações para treinar os pontos fracos.'
      ];
    }

    return [
      `Priorize: ${activeSubject.handbook.whatToImprove.slice(0, 2).join(' e ')}.`,
      'Faça revisão ativa 24h após cada sessão de estudo.',
      'Finalize cada semana com mini simulado + análise de erros.'
    ];
  }, [activeSubject]);

  if (!activeSubject) return null;

  return (
    <div className="min-h-screen bg-slate-100 text-slate-900 p-4 md:p-8">
      <div className="max-w-7xl mx-auto space-y-6">
        <header className="bg-white rounded-2xl p-5 shadow-sm border border-slate-200">
          <h1 className="text-2xl md:text-3xl font-bold flex items-center gap-2">
            <GraduationCap className="text-blue-600" /> Biomed Planner IA
          </h1>
          <p className="text-sm text-slate-600 mt-2">
            App de estudos para Biomedicina com matérias personalizadas, avaliação de nível, apostila adaptativa,
            agenda, objetivos e preparação para provas.
          </p>
        </header>

        <section className="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4">
          <div className="flex flex-wrap gap-2 items-center">
            {subjects.map((subject) => (
              <button
                key={subject.id}
                onClick={() => setActiveSubjectId(subject.id)}
                className={`px-4 py-2 rounded-xl border text-sm font-semibold transition ${
                  subject.id === activeSubjectId
                    ? 'bg-blue-600 text-white border-blue-600'
                    : 'bg-slate-50 text-slate-700 border-slate-200'
                }`}
              >
                {subject.name}
              </button>
            ))}
          </div>

          <div className="flex flex-col md:flex-row gap-2">
            <input
              value={newSubjectName}
              onChange={(e) => setNewSubjectName(e.target.value)}
              placeholder="Nova matéria (ex: Imunologia)"
              className="flex-1 px-4 py-2 rounded-xl border border-slate-300 outline-none focus:ring-2 focus:ring-blue-300"
            />
            <button
              onClick={addSubject}
              className="px-4 py-2 rounded-xl bg-blue-600 text-white font-semibold flex items-center justify-center gap-2"
            >
              <Plus size={16} /> Adicionar matéria
            </button>
            <button
              onClick={() => removeSubject(activeSubject.id)}
              className="px-4 py-2 rounded-xl bg-slate-200 text-slate-700 font-semibold flex items-center justify-center gap-2"
            >
              <Trash2 size={16} /> Remover ativa
            </button>
          </div>
        </section>

        <div className="grid grid-cols-1 xl:grid-cols-3 gap-6">
          <section className="xl:col-span-2 bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4">
            <h2 className="text-lg font-bold flex items-center gap-2">
              <Brain className="text-violet-600" /> {activeSubject.name} · Avaliação Inicial (10 perguntas)
            </h2>

            <div className="space-y-3">
              {activeSubject.quiz.map((item, idx) => (
                <div key={`${activeSubject.id}-${idx}`} className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                  <p className="text-sm font-medium">{idx + 1}. {item.question}</p>
                  <div className="mt-2 flex gap-2 flex-wrap">
                    {[1, 2, 3, 4, 5].map((v) => (
                      <button
                        key={v}
                        onClick={() =>
                          updateActiveSubject((s) => ({
                            ...s,
                            quiz: s.quiz.map((q, i) => (i === idx ? { ...q, answer: v } : q))
                          }))
                        }
                        className={`px-3 py-1 rounded-lg text-xs font-semibold border ${
                          item.answer === v
                            ? 'bg-violet-600 text-white border-violet-600'
                            : 'bg-white border-slate-300 text-slate-700'
                        }`}
                      >
                        {v} - {LEVEL_LABELS[v]}
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>

            <button
              onClick={finishQuizAndGenerate}
              className="px-4 py-2 rounded-xl bg-violet-600 text-white font-semibold flex items-center gap-2"
            >
              <ClipboardCheck size={16} /> Gerar apostila personalizada com IA
            </button>

            {activeSubject.handbook && (
              <article className="p-4 rounded-xl border border-emerald-200 bg-emerald-50 space-y-3">
                <h3 className="font-bold text-emerald-900 flex items-center gap-2">
                  <BookOpen size={16} /> Apostila Inteligente ({activeSubject.handbook.level})
                </h3>
                <p className="text-sm text-emerald-900">{activeSubject.handbook.diagnosis}</p>
                <div>
                  <p className="text-sm font-semibold">Pontos para melhorar:</p>
                  <ul className="list-disc pl-5 text-sm">
                    {activeSubject.handbook.whatToImprove.map((topic) => (
                      <li key={topic}>{topic}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p className="text-sm font-semibold">Plano de estudo:</p>
                  <ul className="list-disc pl-5 text-sm">
                    {activeSubject.handbook.studyPlan.map((line) => (
                      <li key={line}>{line}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p className="text-sm font-semibold">Dicas práticas:</p>
                  <ul className="list-disc pl-5 text-sm">
                    {activeSubject.handbook.practicalTips.map((tip) => (
                      <li key={tip}>{tip}</li>
                    ))}
                  </ul>
                </div>
              </article>
            )}

            <div className="border-t pt-4 space-y-3">
              <button
                onClick={generateNewEvaluation}
                disabled={!activeSubject.handbook}
                className="px-4 py-2 rounded-xl bg-slate-900 text-white font-semibold flex items-center gap-2 disabled:opacity-50"
              >
                <Timer size={16} /> Gerar avaliação da matéria
              </button>

              {activeSubject.generatedTests.map((test) => (
                <div key={test.id} className="rounded-xl border border-slate-200 p-4 bg-slate-50">
                  <h4 className="font-bold">{test.title}</h4>
                  <ol className="list-decimal pl-5 mt-2 text-sm space-y-1">
                    {test.questions.map((q) => (
                      <li key={q}>{q}</li>
                    ))}
                  </ol>
                </div>
              ))}
            </div>
          </section>

          <section className="space-y-6">
            <div className="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-3">
              <h3 className="font-bold flex items-center gap-2"><CalendarDays className="text-blue-600" /> Agenda</h3>
              <input
                value={agendaForm.title}
                onChange={(e) => setAgendaForm((s) => ({ ...s, title: e.target.value }))}
                placeholder="Ex: Revisão de Imunologia"
                className="w-full px-3 py-2 rounded-lg border border-slate-300"
              />
              <input
                type="date"
                value={agendaForm.date}
                onChange={(e) => setAgendaForm((s) => ({ ...s, date: e.target.value }))}
                className="w-full px-3 py-2 rounded-lg border border-slate-300"
              />
              <button onClick={() => addItem('agenda')} className="w-full py-2 rounded-lg bg-blue-600 text-white font-semibold">
                Adicionar à agenda
              </button>
              <ul className="text-sm space-y-1">
                {agendaItems.map((item) => (
                  <li key={item.id}>• {item.date} — {item.title}</li>
                ))}
              </ul>
            </div>

            <div className="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-3">
              <h3 className="font-bold flex items-center gap-2"><Target className="text-amber-600" /> Objetivos</h3>
              <input
                value={goalForm.title}
                onChange={(e) => setGoalForm((s) => ({ ...s, title: e.target.value }))}
                placeholder="Ex: Fechar 100 questões de Parasitologia"
                className="w-full px-3 py-2 rounded-lg border border-slate-300"
              />
              <input
                type="date"
                value={goalForm.deadline}
                onChange={(e) => setGoalForm((s) => ({ ...s, deadline: e.target.value }))}
                className="w-full px-3 py-2 rounded-lg border border-slate-300"
              />
              <button onClick={() => addItem('goal')} className="w-full py-2 rounded-lg bg-amber-500 text-white font-semibold">
                Adicionar objetivo
              </button>
              <ul className="text-sm space-y-1">
                {goalItems.map((item) => (
                  <li key={item.id} className="flex items-center justify-between gap-2">
                    <span className={item.done ? 'line-through text-slate-400' : ''}>
                      {item.deadline} — {item.title}
                    </span>
                    <button onClick={() => toggleGoal(item.id)} className="text-emerald-600">
                      <CheckCircle2 size={16} />
                    </button>
                  </li>
                ))}
              </ul>
            </div>

            <div className="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-3">
              <h3 className="font-bold">Compromissos e ajuda para provas</h3>
              <input
                value={commitmentForm.title}
                onChange={(e) => setCommitmentForm((s) => ({ ...s, title: e.target.value }))}
                placeholder="Ex: Simulado geral"
                className="w-full px-3 py-2 rounded-lg border border-slate-300"
              />
              <input
                type="date"
                value={commitmentForm.date}
                onChange={(e) => setCommitmentForm((s) => ({ ...s, date: e.target.value }))}
                className="w-full px-3 py-2 rounded-lg border border-slate-300"
              />
              <button onClick={() => addItem('commitment')} className="w-full py-2 rounded-lg bg-slate-900 text-white font-semibold">
                Adicionar compromisso
              </button>
              <ul className="text-sm space-y-1">
                {commitments.map((item) => (
                  <li key={item.id}>• {item.date} — {item.title}</li>
                ))}
              </ul>

              <div className="rounded-xl p-3 bg-indigo-50 border border-indigo-200">
                <p className="font-semibold text-indigo-900 mb-2">Plano rápido para provas</p>
                <ul className="list-disc pl-5 text-sm text-indigo-900">
                  {examHelp.map((tip) => (
                    <li key={tip}>{tip}</li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  );
};

export default App;
